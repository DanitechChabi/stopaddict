# StopAddict — modèle de configuration. Copier en .env et remplir.
# Ne jamais commiter .env (il est dans .gitignore).

# --- Côté applications Android (valeurs PUBLIQUES, embarquables dans l'APK) ---
SUPABASE_URL=https://mizdmvklljjayspcnevq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Clé publique Ed25519 (format SPKI, base64) utilisée par l'app pour VÉRIFIER
# les signatures des engagements et des politiques. Publique : OK à embarquer.
SIGNING_PUBLIC_KEY_SPKI_B64=

# --- Côté serveur UNIQUEMENT (secrets Edge Functions, jamais dans l'APK) ---
# Ne JAMAIS mettre ces valeurs ici en clair dans le dépôt. Les définir via
#   supabase secrets set NOM=valeur
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement par
# Supabase dans les Edge Functions : inutile de les définir à la main.
SIGNING_PRIVATE_KEY_PKCS8_B64=
INVITATION_TTL_MINUTES=15
RELEASE_DELAY_HOURS=72
